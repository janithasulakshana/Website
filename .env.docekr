# Docker Compose Environment Variables
# Copy this to .env.docker and fill in your production values

# Backend Configuration
JWT_SECRET=your-production-secret-key-here-minimum-32-characters
NODE_ENV=production
DATABASE_PATH=/data/bookings.db
PORT=5000
HOST=0.0.0.0

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000

# Docker Service Names (for internal networking)
# BACKEND_URL=http://backend:5000

# Splunk Logging (used by docker-compose.splunk.yml)
SPLUNK_HEC_URL=https://http-inputs-your-stack.splunkcloud.com:8088
SPLUNK_HEC_TOKEN=your-hec-token
SPLUNK_INDEX=main
SPLUNK_INSECURE_SKIP_VERIFY=true
